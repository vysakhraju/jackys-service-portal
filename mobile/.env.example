# Copy this file to .env and point it at your backend's LAN address - "localhost"
# only works from a browser/simulator running on the SAME machine as the API, not from
# a real phone or most Android emulators. Find your machine's LAN IP (e.g. via
# `ipconfig` on Windows) and use that, matching whatever port the backend is on.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:3000/api/v1
